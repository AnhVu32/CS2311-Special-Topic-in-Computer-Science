# Sao chép thành .env (cùng thư mục) rồi điền key cần dùng. Không đưa file .env lên git.
OLLAMA_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Tuỳ chọn
# AGENT0_LLM_MAX_RETRIES=6      # số lần thử lại khi gọi LLM lỗi tạm thời (429 / 5xx / timeout)
# AGENT0_LLM_TIMEOUT=300        # timeout mỗi lần gọi LLM (giây)
# AGENT0_DEMO_MODEL=gemma3:12b  # model mặc định của demo web
